# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# server 로컬 이미지 저장소 (운영은 S3)
server/media/*
!server/media/.gitkeep

# Node (front)
node_modules/
.next/
out/
