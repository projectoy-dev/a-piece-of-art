{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteMediaObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::<MEDIA_BUCKET>/artworks/*",
        "arn:aws:s3:::<MEDIA_BUCKET>/artists/*"
      ]
    }
  ]
}
