{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadServerParameters",
      "Effect": "Allow",
      "Action": "ssm:GetParameters",
      "Resource": "arn:aws:ssm:ap-northeast-2:<ACCOUNT_ID>:parameter/a-piece-of-art/<ENV>/server/*"
    },
    {
      "Sid": "DecryptSecureStrings",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:ap-northeast-2:<ACCOUNT_ID>:key/<KMS_KEY_ID>"
    }
  ]
}
