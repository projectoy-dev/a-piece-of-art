{
  "family": "a-piece-of-art-dev-server",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/a-piece-of-art-dev-ecs-execution",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/a-piece-of-art-dev-ecs-task",
  "containerDefinitions": [
    {
      "name": "server",
      "image": "IMAGE_INJECTED_BY_GITHUB_ACTIONS",
      "essential": true,
      "portMappings": [{ "containerPort": 8000, "protocol": "tcp" }],
      "environment": [{ "name": "APP_ENV", "value": "dev" }],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:ssm:ap-northeast-2:<ACCOUNT_ID>:parameter/a-piece-of-art/dev/server/DATABASE_URL" },
        { "name": "SECRET_KEY", "valueFrom": "arn:aws:ssm:ap-northeast-2:<ACCOUNT_ID>:parameter/a-piece-of-art/dev/server/SECRET_KEY" },
        { "name": "CMS_SESSION_SECRET", "valueFrom": "arn:aws:ssm:ap-northeast-2:<ACCOUNT_ID>:parameter/a-piece-of-art/dev/server/CMS_SESSION_SECRET" },
        { "name": "CORS_ORIGINS", "valueFrom": "arn:aws:ssm:ap-northeast-2:<ACCOUNT_ID>:parameter/a-piece-of-art/dev/server/CORS_ORIGINS" },
        { "name": "STORAGE_BACKEND", "valueFrom": "arn:aws:ssm:ap-northeast-2:<ACCOUNT_ID>:parameter/a-piece-of-art/dev/server/STORAGE_BACKEND" },
        { "name": "S3_BUCKET", "valueFrom": "arn:aws:ssm:ap-northeast-2:<ACCOUNT_ID>:parameter/a-piece-of-art/dev/server/S3_BUCKET" },
        { "name": "MEDIA_BASE_URL", "valueFrom": "arn:aws:ssm:ap-northeast-2:<ACCOUNT_ID>:parameter/a-piece-of-art/dev/server/MEDIA_BASE_URL" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/a-piece-of-art-dev-server",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "server"
        }
      }
    }
  ]
}
